 void VideoCameraCapturer::create() {
 	_failed = false;
 
+	// Erst der Weg ueber den Media-Controller, und zwar VOR dem
+	// Aufzaehlen der Geraete: der OMAP3-ISP legt /dev/video0..6 an, und
+	// diese Knoten beim Aufzaehlen zu oeffnen bleibt haengen -- die
+	// Kette ist ja noch nicht verschaltet. Genau daran blieb die
+	// Kameraprobe stehen, ohne eine Zeile zu sagen.
+	_module = harmattanKameraOeffnen();
+	if (_module) {
+		_module->RegisterCaptureDataCallback(this);
+		// Nicht 1280x720: gemessen kostet VP8 dort mehr als ein ganzer
+		// Kern. QVGA ist das, was der A8 mit 15 Bildern traegt.
+		_capability.width = 320;
+		_capability.height = 240;
+		_capability.maxFPS = 15;
+		_capability.videoType = webrtc::VideoType::kI420;
+		if (_module->StartCapture(_capability) == 0) {
+			_dimensions = std::make_pair(_capability.width, _capability.height);
+			return;
+		}
+		destroy();
+	}
+
